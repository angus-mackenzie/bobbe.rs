{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bobbe-rs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "routes": [
  { "pattern": "bobbe.rs", "custom_domain": true },
  { "pattern": "www.bobbe.rs", "custom_domain": true }
],
}