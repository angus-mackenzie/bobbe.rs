---
import { bobMap } from '../config/bob-map';
import Arrow from './Arrow.astro';
---
<section class="bob-map" aria-labelledby="bob-map-title">
  <div class="map-heading">
    <div>
      <p class="eyebrow">{bobMap.title}</p>
      <h1 id="bob-map-title">Bobspots.</h1>
      <p class="map-intro">This highlights all the places our members have bobbed in the world.</p>
    </div>
    <nav class="map-actions" aria-label="Map links">
      <a class="text-link" href={bobMap.viewUrl} target="_blank" rel="noopener noreferrer">Open map <Arrow diagonal /><span class="sr-only"> (opens in a new tab)</span></a>
      <a class="text-link" href={bobMap.addUrl} target="_blank" rel="noopener noreferrer">Add a bobspot <Arrow diagonal /><span class="sr-only"> (opens in a new tab)</span></a>
    </nav>
  </div>
  <a class="map-skip" href="#after-map">Skip interactive map</a>
  <iframe
    class="map-frame"
    src={bobMap.embedUrl}
    title={`${bobMap.title} — interactive Google map`}
    width="1200"
    height="640"
    loading="lazy"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
  <p class="map-credit" id="after-map" tabindex="-1">Map by <a href={bobMap.sourceUrl} target="_blank" rel="noopener noreferrer">{bobMap.creator}<span class="sr-only"> (opens in a new tab)</span></a>.</p>
</section>
