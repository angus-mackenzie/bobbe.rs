---
import { site } from '../config/site';
---
<section class="about shell" id="about" aria-labelledby="about-title">
  <p class="eyebrow section-label">The Bobbers</p>
  <div class="about-content">
    <h2 id="about-title">Cool water.<br />Cooler people.</h2>
    <div class="about-details">
      <p>We’re The Beach Bobbers. A social club hanging out in the waves twice a week.</p>
      <div class="meetup"><span class="eyebrow">Come join us</span><p>{site.schedule}</p><a href={site.join}>Fill in the form for the exact location.</a></div>
    </div>
  </div>
</section>
