---
import { Picture } from 'astro:assets';
import { gallery } from '../data/gallery';
---
<section class="gallery shell" id="gallery" aria-labelledby="gallery-title">
  <div class="gallery-heading"><p class="eyebrow">This could be you</p><h2 id="gallery-title">Wish you were here.</h2><p>Have you heard about the mammalian dive reflex? <br>You will soon.</p></div>
  <div class="gallery-grid">
    {gallery.map((photo, index) => (
      <figure class:list={['gallery-photo', `photo-${index + 1}`]}>
        <Picture src={photo.image} alt={photo.alt} width={1920} formats={['avif', 'webp']} fallbackFormat="jpeg" widths={[400, 800, 1280, 1920]} sizes={index === 0 ? '(min-width: 1600px) 858px, (min-width: 768px) 58vw, calc(100vw - 40px)' : '(min-width: 1600px) 590px, (min-width: 768px) 40vw, calc(100vw - 40px)'} quality={76} loading="lazy" decoding="async" />
        <figcaption><span>{photo.caption}</span><span aria-hidden="true">0{index + 1}</span></figcaption>
      </figure>
    ))}
  </div>
</section>
