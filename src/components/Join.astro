---
import { site } from '../config/site';
import Arrow from './Arrow.astro';
---
<section class="join" aria-labelledby="join-title">
  <div class="shell join-inner">
    <p class="eyebrow">We get coffee after</p>
    <h2 id="join-title">Take the plunge.<br />Or don't. <br>It's super chill</h2>
    <div class="join-bottom"><p>{site.schedule}<br />Fill in the form and we’ll share the exact location.</p><a class="join-button" href={site.join}>Join the bobbers <Arrow diagonal /></a></div>
  </div>
</section>
